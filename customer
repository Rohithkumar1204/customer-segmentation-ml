
# Customer Segmentation Project
# K-Means Clustering using Python

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score

# 1. Create sample customer dataset
np.random.seed(42)

data = pd.DataFrame({
    "CustomerID": range(1, 201),
    "Age": np.random.randint(18, 70, 200),
    "AnnualIncome": np.random.randint(15000, 120000, 200),
    "SpendingScore": np.random.randint(1, 101, 200)
})

print("First 5 Customers:")
print(data.head())

# 2. Select features
X = data[["Age", "AnnualIncome", "SpendingScore"]]

# 3. Standardize the data
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 4. Find suitable cluster count using elbow method
inertias = []

for k in range(2, 9):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X_scaled)
    inertias.append(model.inertia_)

plt.figure(figsize=(7, 4))
plt.plot(range(2, 9), inertias, marker="o")
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.grid(True)
plt.show()

# 5. Train K-Means model
k = 4
kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
data["Cluster"] = kmeans.fit_predict(X_scaled)

# 6. Evaluate clustering
score = silhouette_score(X_scaled, data["Cluster"])
print("\nNumber of clusters:", k)
print("Silhouette Score:", round(score, 3))

# 7. Display customer segments
print("\nCustomer Segments:")
print(
    data.groupby("Cluster")[
        ["Age", "AnnualIncome", "SpendingScore"]
    ].mean().round(2)
)

print("\nCustomers in Each Cluster:")
print(data["Cluster"].value_counts().sort_index())

# 8. Visualize customer segments
plt.figure(figsize=(9, 6))
sns.scatterplot(
    data=data,
    x="AnnualIncome",
    y="SpendingScore",
    hue="Cluster",
    palette="viridis",
    s=80
)
plt.title("Customer Segmentation")
plt.xlabel("Annual Income")
plt.ylabel("Spending Score")
plt.tight_layout()
plt.show()

# 9. Visualize cluster sizes
sns.countplot(data=data, x="Cluster")
plt.title("Number of Customers in Each Segment")
plt.tight_layout()
plt.show()

# 10. Save results
data.to_csv("customer_segments.csv", index=False)
print("\nResults saved to customer_segments.csv")
